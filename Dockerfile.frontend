# Build stage
FROM node:24.16.0-alpine AS builder
WORKDIR /build
# VITE_API_BASE_URL is injected at build time (Vite bakes it into the static bundle).
# - Local/dev (docker compose): defaults to http://localhost:8080 (passed via build arg).
# - Kubernetes (CI deploy/scan): left empty so the app falls back to the "/api" same-origin
#   prefix, which the ingress routes to the backend. No need to edit this file per target.
# VITE_API_BASE_URL needs to be commented out to build the frontend image in CI/CD pipelines, as the build arg is not passed in that context. The frontend will fall back to the default "/api" same-origin prefix.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
COPY frontend/package*.json ./
RUN npm ci

COPY schema.graphqls ../schema.graphqls
COPY frontend .
RUN npm run build

# Runtime stage - using node slim for reduced vulnerabilities
FROM node:24.16.0-slim
WORKDIR /app
RUN npm install -g serve

COPY --from=builder /build/dist ./dist
# Run as a non-root user for container hardening
RUN groupadd -g 10001 appgroup && useradd -u 10001 -g appgroup -m appuser
RUN chown -R appuser:appgroup /app
USER 10001

EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
