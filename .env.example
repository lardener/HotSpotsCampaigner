# Auth0 Configuration (multi-provider SSO: Google, Microsoft, GitHub, ...)
# Get these values from the Auth0 Dashboard > Applications > Settings
# https://manage.auth0.com/dashboard

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id-here
AUTH0_CLIENT_SECRET=your-auth0-client-secret-here
OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/auth0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MySQL parameters
MYSQL_DATABASE=db_name_here
MYSQL_USER=db_user_here
MYSQL_PASSWORD=db_password_here
MYSQL_ROOT_PASSWORD=db_root_password_here
MYSQL_PORT=3306